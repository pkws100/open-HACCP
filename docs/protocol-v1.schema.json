{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-haccp.example/schemas/sensor-protocol-v1.json",
  "title": "Open HACCP Sensor Protocol V1 measurement batch",
  "allOf": [
    { "$ref": "#/$defs/batchEnvelope" },
    {
      "properties": {
        "measurements": {
          "items": { "$ref": "#/$defs/measurement" }
        }
      }
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "versionString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "diagnostics": {
      "type": "object",
      "required": ["battery_mv", "rssi_dbm", "wifi_connect_ms", "boot_count"],
      "properties": {
        "battery_mv": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "rssi_dbm": { "type": "integer", "minimum": -120, "maximum": 0 },
        "wifi_connect_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "boot_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_.-]{1,64}$" }
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": [
        "measurement_point",
        "sequence",
        "measured_at",
        "temperature_c",
        "humidity_rh",
        "battery_mv"
      ],
      "properties": {
        "measurement_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "measured_at": { "$ref": "#/$defs/utcTimestamp" },
        "temperature_c": { "type": "number", "minimum": -100, "maximum": 150 },
        "humidity_rh": { "type": "number", "minimum": 0, "maximum": 100 },
        "battery_mv": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "batchEnvelope": {
      "type": "object",
      "required": [
        "protocol_version",
        "batch_id",
        "firmware_version",
        "hardware_revision",
        "sent_at",
        "diagnostics",
        "measurements"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "firmware_version": { "$ref": "#/$defs/versionString" },
        "hardware_revision": { "$ref": "#/$defs/versionString" },
        "sent_at": { "$ref": "#/$defs/utcTimestamp" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "protocol_version",
        "firmware_version",
        "hardware_revision",
        "battery_mv",
        "rssi_dbm",
        "wifi_connect_ms",
        "boot_count"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "firmware_version": { "$ref": "#/$defs/versionString" },
        "hardware_revision": { "$ref": "#/$defs/versionString" },
        "battery_mv": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "rssi_dbm": { "type": "integer", "minimum": -120, "maximum": 0 },
        "wifi_connect_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "boot_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_.-]{1,64}$" }
        }
      },
      "additionalProperties": true
    }
  }
}

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
MIGRATE_ON_START=true
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=18082

DB_HOST=db
DB_PORT=3306
DB_DATABASE=haccp
DB_USERNAME=haccp
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-random-root-password

# Generate with: openssl rand -hex 32
DEVICE_API_KEY_PEPPER=replace-with-64-random-hex-characters
DASHBOARD_USERNAME=haccp-monitor
DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
